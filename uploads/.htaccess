# Disable script execution in uploads directory
# Prevent PHP engine execution
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Disable CGI execution and directory browsing
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar .inc .cgi .pl .py .sh .bash .bat .cmd .exe

# Deny access to executable scripts and sensitive files
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|phar|inc|cgi|pl|py|sh|bash|bat|cmd|exe|htaccess|env|ini|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Only allow safe media and document files
<FilesMatch "\.(?i:jpg|jpeg|png|gif|webp|svg|ico|pdf|doc|docx|xls|xlsx|txt|csv)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>
