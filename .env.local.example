# Copy this file to .env.local and fill in your values.
# start-server.bat loads it automatically. .env.local is ignored by git.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Email for 2FA codes - use ONE option (see GMAIL-OTP-SETUP.md)
# Option A: Gmail relay (Google Apps Script)
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
# Option B: Gmail SMTP with an App Password
SMTP_USER=
SMTP_PASS=

# "Scan quotation" on Create Quotation (reads a quotation image with Claude)
# Key from https://console.anthropic.com - leave empty to hide the scan button
ANTHROPIC_API_KEY=
